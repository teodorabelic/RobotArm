<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Client.K1.Desktop.MainWindow"
        Title="RobotArm - K1 (sve komande)"
        Width="480" Height="260">

	<StackPanel Margin="12" Spacing="8">
		<TextBlock Text="RobotArm - K1 (sve komande)" FontWeight="Bold"/>

		<WrapPanel>
			<!-- razmak među dugmadima (zamenjuje Spacing) -->
			<WrapPanel.Styles>
				<!-- VARIJANTA 1: za sve kontrole u WrapPanel-u -->
				<Style Selector="WrapPanel > Control">
					<Setter Property="Margin" Value="6"/>
				</Style>
				<!-- ili, ako želiš samo za dugmad:
        <Style Selector="WrapPanel > Button">
          <Setter Property="Margin" Value="6"/>
        </Style>
        -->
			</WrapPanel.Styles>

			<Button Content="Left"   Click="Left_Click"/>
			<Button Content="Right"  Click="Right_Click"/>
			<Button Content="Up"     Click="Up_Click"/>
			<Button Content="Down"   Click="Down_Click"/>
			<Button Content="Rotate" Click="Rotate_Click"/>
		</WrapPanel>

		<Button Content="Refresh State" Click="Refresh_Click" />
		<TextBlock x:Name="StateText"  Text="State: -" />
		<TextBlock x:Name="StatusText" Text="Status: ready" />
	</StackPanel>
</Window>
